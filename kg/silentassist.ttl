# SilentAssist knowledge graph (CogLign) - canonical source. ADR 0003 D1, D2, D16, D18.
# Alignment: SAREF v4.1.1 (State / StateOfInterest / StateValue pattern), BOT, SOSA 2017, sa: extension.
# On/off states are minted as sa:On / sa:Off / sa:Standby (saref:OnState etc. are deleted in v4.1.1).
# Copy, don't import: only two upstream axioms are copied. bot:hasElement is never asserted.
# POC/js/kg/ontology.js carries this exact text (byte-identical; checked by kg/tests/load.test.js).
# LF line endings, ASCII only. Not clinically validated.
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix saref: <https://saref.etsi.org/core/> .
@prefix bot:   <https://w3id.org/bot#> .
@prefix sosa:  <http://www.w3.org/ns/sosa/> .
@prefix unit:  <https://qudt.org/2.1/vocab/unit/> .
@prefix sa:    <https://silentassist.example/ns#> .
@prefix :      <https://silentassist.example/home#> .

# ---------- 1. Upstream axioms we rely on (copied, not imported) ----------
saref:Actuator  rdfs:subClassOf saref:Device .
saref:Appliance rdfs:subClassOf saref:Device .

# ---------- 2. SilentAssist TBox (sa:) ----------
sa:Light          rdfs:subClassOf saref:Actuator , bot:Element ; rdfs:label "Light" ; sa:hubLabel "Lights" .
sa:CeilingLight   rdfs:subClassOf sa:Light ; rdfs:label "Ceiling light" .
sa:Lamp           rdfs:subClassOf sa:Light ; rdfs:label "Lamp" .
sa:Fan            rdfs:subClassOf saref:Actuator , bot:Element ; rdfs:label "Fan" ; sa:hubLabel "Fans" .
sa:CeilingFan     rdfs:subClassOf sa:Fan ; rdfs:label "Ceiling fan" .
sa:AirConditioner rdfs:subClassOf saref:Appliance , bot:Element ; rdfs:label "Air Conditioner" ; sa:hubLabel "Air Conditioner" .
sa:Television     rdfs:subClassOf saref:Appliance , bot:Element ; rdfs:label "TV" ; sa:hubLabel "TV & Media" .
sa:Preset         rdfs:label "Semantic preset" ; sa:hubLabel "Presets" .
sa:PresetStep     rdfs:label "Preset step" .
sa:User           rdfs:label "User" .
sa:RiskTier       rdfs:label "Risk tier" .
sa:RiskRule       rdfs:label "Risk rule" .
sa:ActionExecution rdfs:subClassOf saref:CommandExecution ; rdfs:label "Action execution" .
sa:ErrPObservation rdfs:subClassOf sosa:Observation ; rdfs:label "ErrP observation" .
sa:ErrPFeedback   rdfs:subClassOf sa:ErrPObservation ; rdfs:label "ErrP feedback (penalty record, ranking only)" .
sa:RoomObservation rdfs:subClassOf sosa:Observation ; rdfs:label "Active-room observation" .
sa:VirtualSensor  rdfs:subClassOf sosa:Sensor ; rdfs:label "Virtual sensor (simulated)" .

# States (SAREF v4.1.1 pattern: State kind + StateValue individuals)
sa:PowerState    a saref:State ; rdfs:label "Power" .
sa:On      a saref:StateValue ; saref:isValueOfState sa:PowerState ; rdfs:label "ON" ;      sa:isActive true .
sa:Off     a saref:StateValue ; saref:isValueOfState sa:PowerState ; rdfs:label "OFF" ;     sa:isActive false .
sa:Standby a saref:StateValue ; saref:isValueOfState sa:PowerState ; rdfs:label "Standby" ; sa:isActive false .
sa:FanSpeedState a saref:State ; rdfs:label "Fan speed" .
sa:SpeedLow    a saref:StateValue ; saref:isValueOfState sa:FanSpeedState ; rdfs:label "Low" ;    sa:level 1 .
sa:SpeedMedium a saref:StateValue ; saref:isValueOfState sa:FanSpeedState ; rdfs:label "Medium" ; sa:level 2 .
sa:SpeedHigh   a saref:StateValue ; saref:isValueOfState sa:FanSpeedState ; rdfs:label "High" ;   sa:level 3 .
sa:ACModeState a saref:State ; rdfs:label "AC mode" .
sa:ModeCool a saref:StateValue ; saref:isValueOfState sa:ACModeState ; rdfs:label "Cool" .
sa:ModeFan  a saref:StateValue ; saref:isValueOfState sa:ACModeState ; rdfs:label "Fan" .
sa:ModeDry  a saref:StateValue ; saref:isValueOfState sa:ACModeState ; rdfs:label "Dry" .

# Property kinds
sa:Brightness        a saref:Property ; rdfs:label "Brightness" .
sa:TargetTemperature a saref:Property ; rdfs:label "Setpoint" .
sa:Channel           a saref:Property ; rdfs:label "Channel" .
sa:Volume            a saref:Property ; rdfs:label "Volume" .

# Functions and command kinds (risk tiers attach to devices, not commands: ADR 0003 D2)
sa:OnOffFunction      a saref:Function ; saref:hasCommand sa:TurnOn , sa:TurnOff .
sa:DimmingFunction    a saref:Function ; saref:hasCommand sa:SetBrightness .
sa:FanSpeedFunction   a saref:Function ; saref:hasCommand sa:SetFanSpeed .
sa:ThermostatFunction a saref:Function ; saref:hasCommand sa:SetTemperature .
sa:ACModeFunction     a saref:Function ; saref:hasCommand sa:SetMode .
sa:ChannelFunction    a saref:Function ; saref:hasCommand sa:ChannelUp , sa:ChannelDown .
sa:VolumeFunction     a saref:Function ; saref:hasCommand sa:VolumeUp , sa:VolumeDown .

sa:TurnOn  a saref:Command ; rdfs:label "Turn On" ;  saref:targets sa:PowerState ; sa:prefersActive false .
sa:TurnOff a saref:Command ; rdfs:label "Turn Off" ; saref:targets sa:PowerState ; sa:prefersActive true .
sa:SetBrightness  a saref:Command ; rdfs:label "Adjust Brightness" ; saref:targets sa:Brightness .
sa:SetFanSpeed    a saref:Command ; rdfs:label "Set Fan Speed" ;     saref:targets sa:FanSpeedState .
sa:SetTemperature a saref:Command ; rdfs:label "Set Temperature" ;   saref:targets sa:TargetTemperature .
sa:SetMode        a saref:Command ; rdfs:label "Set Mode" ;          saref:targets sa:ACModeState .
sa:ChannelUp   a saref:Command ; rdfs:label "Channel +" ; saref:targets sa:Channel .
sa:ChannelDown a saref:Command ; rdfs:label "Channel -" ; saref:targets sa:Channel .
sa:VolumeUp    a saref:Command ; rdfs:label "Volume +" ;  saref:targets sa:Volume .
sa:VolumeDown  a saref:Command ; rdfs:label "Volume -" ;  saref:targets sa:Volume .

# Risk tiers and the thermal rule (ADR 0003 D2, D16, D17)
sa:LowRisk    a sa:RiskTier ; rdfs:label "Low: Autonomic" ;           sa:tierName "Low" ;    sa:rank 1 .
sa:MediumRisk a sa:RiskTier ; rdfs:label "Medium: Guarded" ;          sa:tierName "Medium" ; sa:rank 2 .
sa:HighRisk   a sa:RiskTier ; rdfs:label "High: Caregiver Approval" ; sa:tierName "High" ;   sa:rank 3 .
sa:ThermalHazardRule a sa:RiskRule ; rdfs:label "AC setpoint outside 18-30 degC (strict; 18 and 30 are safe)" ;
    sa:appliesToCommand sa:SetTemperature ; sa:minSafe 18 ; sa:maxSafe 30 ; sa:tierIfViolated sa:HighRisk .

# ---------- 3. Building (BOT) ----------
# The Smart TV is in the Master Bedroom (ADR 0003 D18 changes the KG brief: users are bed-bound).
:Home a bot:Building ; rdfs:label "Home" ; bot:hasStorey :GroundFloor .
:GroundFloor a bot:Storey ; rdfs:label "Ground Floor" ; bot:hasSpace :MasterBedroom , :LivingRoom .
:MasterBedroom a bot:Space ; rdfs:label "Master Bedroom" ;
    bot:containsElement :BedroomCeilingLight , :BedsideLamp , :CeilingFan , :AirConditioner , :SmartTV .
:LivingRoom a bot:Space ; rdfs:label "Living Room" ;
    bot:containsElement :LivingRoomLight .

# ---------- 4. Devices (README / ADR 0003 D18 initial state) ----------
:BedroomCeilingLight a sa:CeilingLight ; rdfs:label "Bedroom Ceiling Light" ; sa:displayOrder 1 ; sa:hasRiskTier sa:LowRisk ;
    saref:hasFunction sa:OnOffFunction , sa:DimmingFunction ;
    saref:hasStateOfInterest :BedroomCeilingLight_power ; saref:hasPropertyOfInterest :BedroomCeilingLight_brightness .
:BedroomCeilingLight_power a saref:StateOfInterest ; saref:hasStateKind sa:PowerState ; saref:hasStateValue sa:Off .
:BedroomCeilingLight_brightness a saref:PropertyOfInterest ; saref:hasPropertyKind sa:Brightness ; saref:hasPropertyValue :BedroomCeilingLight_brightness_v .
:BedroomCeilingLight_brightness_v a saref:PropertyValue ; saref:hasValue 100 ; saref:isMeasuredIn unit:PERCENT .

:BedsideLamp a sa:Lamp ; rdfs:label "Bedside Lamp" ; sa:displayOrder 2 ; sa:hasRiskTier sa:LowRisk ;
    saref:hasFunction sa:OnOffFunction , sa:DimmingFunction ;
    saref:hasStateOfInterest :BedsideLamp_power ; saref:hasPropertyOfInterest :BedsideLamp_brightness .
:BedsideLamp_power a saref:StateOfInterest ; saref:hasStateKind sa:PowerState ; saref:hasStateValue sa:Off .
:BedsideLamp_brightness a saref:PropertyOfInterest ; saref:hasPropertyKind sa:Brightness ; saref:hasPropertyValue :BedsideLamp_brightness_v .
:BedsideLamp_brightness_v a saref:PropertyValue ; saref:hasValue 100 ; saref:isMeasuredIn unit:PERCENT .

:LivingRoomLight a sa:CeilingLight ; rdfs:label "Living Room Light" ; sa:displayOrder 3 ; sa:hasRiskTier sa:LowRisk ;
    saref:hasFunction sa:OnOffFunction , sa:DimmingFunction ;
    saref:hasStateOfInterest :LivingRoomLight_power ; saref:hasPropertyOfInterest :LivingRoomLight_brightness .
:LivingRoomLight_power a saref:StateOfInterest ; saref:hasStateKind sa:PowerState ; saref:hasStateValue sa:On .
:LivingRoomLight_brightness a saref:PropertyOfInterest ; saref:hasPropertyKind sa:Brightness ; saref:hasPropertyValue :LivingRoomLight_brightness_v .
:LivingRoomLight_brightness_v a saref:PropertyValue ; saref:hasValue 100 ; saref:isMeasuredIn unit:PERCENT .

# Fan speed is unbound at reset (power OFF, no speed yet).
:CeilingFan a sa:CeilingFan ; rdfs:label "Ceiling Fan" ; sa:hasRiskTier sa:LowRisk ;
    saref:hasFunction sa:OnOffFunction , sa:FanSpeedFunction ;
    saref:hasStateOfInterest :CeilingFan_power , :CeilingFan_speed .
:CeilingFan_power a saref:StateOfInterest ; saref:hasStateKind sa:PowerState ; saref:hasStateValue sa:Off .
:CeilingFan_speed a saref:StateOfInterest ; saref:hasStateKind sa:FanSpeedState .

# AC setpoint range 16-32 degC, step 1, clamped (UI must reach <18 and >30 to show CAREGIVER APPROVAL).
:AirConditioner a sa:AirConditioner ; rdfs:label "Air Conditioner" ; sa:hasRiskTier sa:MediumRisk ;
    saref:hasFunction sa:OnOffFunction , sa:ThermostatFunction , sa:ACModeFunction ;
    saref:hasStateOfInterest :AirConditioner_power , :AirConditioner_mode ;
    saref:hasPropertyOfInterest :AirConditioner_setpoint .
:AirConditioner_power a saref:StateOfInterest ; saref:hasStateKind sa:PowerState ; saref:hasStateValue sa:On .
:AirConditioner_mode  a saref:StateOfInterest ; saref:hasStateKind sa:ACModeState ; saref:hasStateValue sa:ModeCool .
:AirConditioner_setpoint a saref:PropertyOfInterest ; saref:hasPropertyKind sa:TargetTemperature ; saref:hasPropertyValue :AirConditioner_setpoint_v .
:AirConditioner_setpoint_v a saref:PropertyValue ; saref:hasValue 24 ; saref:isMeasuredIn unit:DEG_C ; sa:minValue 16 ; sa:maxValue 32 .

:SmartTV a sa:Television ; rdfs:label "Smart TV" ; sa:hasRiskTier sa:LowRisk ;
    saref:hasFunction sa:OnOffFunction , sa:ChannelFunction , sa:VolumeFunction ;
    saref:hasStateOfInterest :SmartTV_power ;
    saref:hasPropertyOfInterest :SmartTV_channel , :SmartTV_volume .
:SmartTV_power a saref:StateOfInterest ; saref:hasStateKind sa:PowerState ; saref:hasStateValue sa:Standby .
:SmartTV_channel a saref:PropertyOfInterest ; saref:hasPropertyKind sa:Channel ; saref:hasPropertyValue :SmartTV_channel_v .
:SmartTV_channel_v a saref:PropertyValue ; saref:hasValue 1 ; sa:minValue 1 ; sa:maxValue 99 .
:SmartTV_volume a saref:PropertyOfInterest ; saref:hasPropertyKind sa:Volume ; saref:hasPropertyValue :SmartTV_volume_v .
:SmartTV_volume_v a saref:PropertyValue ; saref:hasValue 20 ; saref:isMeasuredIn unit:PERCENT ; sa:minValue 0 ; sa:maxValue 100 .

# ---------- 5. Presets (ADR 0003 D18; README fixes the names only). Preset tiers are computed, not stored. ----------
:NightMode a sa:Preset ; rdfs:label "Night Mode" ; sa:displayOrder 1 ;
    sa:hasStep :NightMode_1 , :NightMode_2 , :NightMode_3 , :NightMode_4 .
:NightMode_1 a sa:PresetStep ; sa:stepOrder 1 ; sa:targetDevice :BedroomCeilingLight ; sa:command sa:TurnOff ; sa:targetStateValue sa:Off .
:NightMode_2 a sa:PresetStep ; sa:stepOrder 2 ; sa:targetDevice :LivingRoomLight ;     sa:command sa:TurnOff ; sa:targetStateValue sa:Off .
:NightMode_3 a sa:PresetStep ; sa:stepOrder 3 ; sa:targetDevice :SmartTV ;             sa:command sa:TurnOff ; sa:targetStateValue sa:Standby .
:NightMode_4 a sa:PresetStep ; sa:stepOrder 4 ; sa:targetDevice :AirConditioner ;      sa:command sa:SetTemperature ; sa:targetValue 25 .

:AllLightsOff a sa:Preset ; rdfs:label "All Lights Off" ; sa:displayOrder 2 ;
    sa:hasStep :AllLightsOff_1 , :AllLightsOff_2 , :AllLightsOff_3 .
:AllLightsOff_1 a sa:PresetStep ; sa:stepOrder 1 ; sa:targetDevice :BedroomCeilingLight ; sa:command sa:TurnOff ; sa:targetStateValue sa:Off .
:AllLightsOff_2 a sa:PresetStep ; sa:stepOrder 2 ; sa:targetDevice :BedsideLamp ;         sa:command sa:TurnOff ; sa:targetStateValue sa:Off .
:AllLightsOff_3 a sa:PresetStep ; sa:stepOrder 3 ; sa:targetDevice :LivingRoomLight ;     sa:command sa:TurnOff ; sa:targetStateValue sa:Off .

:CoolingMode a sa:Preset ; rdfs:label "Cooling Mode" ; sa:displayOrder 3 ;
    sa:hasStep :CoolingMode_1 , :CoolingMode_2 , :CoolingMode_3 , :CoolingMode_4 .
:CoolingMode_1 a sa:PresetStep ; sa:stepOrder 1 ; sa:targetDevice :AirConditioner ; sa:command sa:TurnOn ;         sa:targetStateValue sa:On .
:CoolingMode_2 a sa:PresetStep ; sa:stepOrder 2 ; sa:targetDevice :AirConditioner ; sa:command sa:SetMode ;        sa:targetStateValue sa:ModeCool .
:CoolingMode_3 a sa:PresetStep ; sa:stepOrder 3 ; sa:targetDevice :AirConditioner ; sa:command sa:SetTemperature ; sa:targetValue 22 .
:CoolingMode_4 a sa:PresetStep ; sa:stepOrder 4 ; sa:targetDevice :CeilingFan ;     sa:command sa:SetFanSpeed ;    sa:targetStateValue sa:SpeedMedium .

:WatchTV a sa:Preset ; rdfs:label "Watch TV" ; sa:displayOrder 4 ;
    sa:hasStep :WatchTV_1 , :WatchTV_2 , :WatchTV_3 .
:WatchTV_1 a sa:PresetStep ; sa:stepOrder 1 ; sa:targetDevice :SmartTV ;             sa:command sa:TurnOn ;        sa:targetStateValue sa:On .
:WatchTV_2 a sa:PresetStep ; sa:stepOrder 2 ; sa:targetDevice :BedroomCeilingLight ; sa:command sa:TurnOff ;       sa:targetStateValue sa:Off .
:WatchTV_3 a sa:PresetStep ; sa:stepOrder 3 ; sa:targetDevice :BedsideLamp ;         sa:command sa:SetBrightness ; sa:targetValue 25 .

# ---------- 6. User context (SOSA). The room selector is a SIMULATED operator sensor. ----------
# roomConfidence 0.95 is README-pinned: given S = 0.94, "89%" forces P(room) in [0.9415, 0.9521] (ADR 0003 D11).
sa:Occupancy a sosa:ObservableProperty ; rdfs:label "room occupancy" .
:RoomSelector a sa:VirtualSensor ; rdfs:label "Operator active-room selector (simulated)" .
:ErrPDetector a sa:VirtualSensor ; rdfs:label "ErrP detector (FCz/Cz)" .
:Patient a sa:User ; rdfs:label "Patient" .
:Obs_room_0 a sa:RoomObservation ; sosa:madeBySensor :RoomSelector ; sosa:hasFeatureOfInterest :Patient ;
    sosa:observedProperty sa:Occupancy ; sosa:hasResult :MasterBedroom ; sa:confidence 0.95 ; sa:sequence 0 ;
    sosa:resultTime "2026-03-01T21:00:00"^^xsd:dateTime .

# ---------- 7. Synthetic seed history: last 10 confirmed light activations (6 / 2 / 2) ----------
# SYNTHETIC SEED HISTORY - not real interaction logs. H01 is the newest, H10 (a ceiling event) the oldest,
# so one more confirmed ceiling activation keeps the ceiling at 6/10 (ADR 0003 D10, D18).
:H01 a sa:ActionExecution ; sa:synthetic true ; sa:resolvedEntity :BedroomCeilingLight ; sa:command sa:TurnOn ; sa:inRoom :MasterBedroom ; sa:outcome sa:Confirmed ; saref:hasTimestamp "2026-03-01T20:30:00"^^xsd:dateTime .
:H02 a sa:ActionExecution ; sa:synthetic true ; sa:resolvedEntity :BedsideLamp ;         sa:command sa:TurnOn ; sa:inRoom :MasterBedroom ; sa:outcome sa:Confirmed ; saref:hasTimestamp "2026-03-01T19:10:00"^^xsd:dateTime .
:H03 a sa:ActionExecution ; sa:synthetic true ; sa:resolvedEntity :BedroomCeilingLight ; sa:command sa:TurnOn ; sa:inRoom :MasterBedroom ; sa:outcome sa:Confirmed ; saref:hasTimestamp "2026-03-01T07:00:00"^^xsd:dateTime .
:H04 a sa:ActionExecution ; sa:synthetic true ; sa:resolvedEntity :LivingRoomLight ;     sa:command sa:TurnOn ; sa:inRoom :LivingRoom ;    sa:outcome sa:Confirmed ; saref:hasTimestamp "2026-02-28T18:40:00"^^xsd:dateTime .
:H05 a sa:ActionExecution ; sa:synthetic true ; sa:resolvedEntity :BedroomCeilingLight ; sa:command sa:TurnOn ; sa:inRoom :MasterBedroom ; sa:outcome sa:Confirmed ; saref:hasTimestamp "2026-02-28T07:05:00"^^xsd:dateTime .
:H06 a sa:ActionExecution ; sa:synthetic true ; sa:resolvedEntity :BedroomCeilingLight ; sa:command sa:TurnOn ; sa:inRoom :MasterBedroom ; sa:outcome sa:Confirmed ; saref:hasTimestamp "2026-02-27T21:15:00"^^xsd:dateTime .
:H07 a sa:ActionExecution ; sa:synthetic true ; sa:resolvedEntity :BedsideLamp ;         sa:command sa:TurnOn ; sa:inRoom :MasterBedroom ; sa:outcome sa:Confirmed ; saref:hasTimestamp "2026-02-27T20:30:00"^^xsd:dateTime .
:H08 a sa:ActionExecution ; sa:synthetic true ; sa:resolvedEntity :LivingRoomLight ;     sa:command sa:TurnOn ; sa:inRoom :LivingRoom ;    sa:outcome sa:Confirmed ; saref:hasTimestamp "2026-02-27T17:50:00"^^xsd:dateTime .
:H09 a sa:ActionExecution ; sa:synthetic true ; sa:resolvedEntity :BedroomCeilingLight ; sa:command sa:TurnOn ; sa:inRoom :MasterBedroom ; sa:outcome sa:Confirmed ; saref:hasTimestamp "2026-02-27T07:10:00"^^xsd:dateTime .
:H10 a sa:ActionExecution ; sa:synthetic true ; sa:resolvedEntity :BedroomCeilingLight ; sa:command sa:TurnOn ; sa:inRoom :MasterBedroom ; sa:outcome sa:Confirmed ; saref:hasTimestamp "2026-02-26T21:05:00"^^xsd:dateTime .

# ---------- 8. ErrP mirror (runtime only) ----------
# sa:ErrPObservation / sa:ErrPFeedback nodes are added by SA.kg.mirror from the detector's computed values
# (sa:posterior, sa:likelihoodRatio, sa:prior, sa:interactionsSince, sa:aboutEntity, sa:command, sa:inRoom).
# None exist at reset. Nothing is scripted (ADR 0002 D19).
